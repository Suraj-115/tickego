PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tickego
JWT_SECRET=your_jwt_secret_key_here

# Email Configuration (Gmail App Password or Brevo)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
# Or Brevo SMTP (optional):
# BREVO_SMTP_USER=your_brevo_login
# BREVO_SMTP_PASS=your_brevo_smtp_key

# Razorpay Credentials (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_SECRET=your_razorpay_secret
